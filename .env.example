# ─── Copiar a .env y completar. NUNCA commitear .env ───

# JWT (compartido entre gateway y auth-service)
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Postgres — una base por servicio
AUTH_DB_URL=postgres://auth_user:changeme@auth-db:5432/auth_db
WALLET_DB_URL=postgres://wallet_user:changeme@wallet-db:5432/wallet_db
TRANSACTIONS_DB_URL=postgres://tx_user:changeme@transactions-db:5432/transactions_db

# Redis (locks de idempotencia)
REDIS_URL=redis://redis:6379
